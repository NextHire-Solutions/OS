+
+// --- BrokerStaffer single sign-on -------------------------------------------
+//
+// Placed BEFORE express.static on purpose: the gate has to cover the UI, not
+// just the API. Serving index.html to anonymous visitors and only refusing the
+// XHRs behind it would still leak the entire interface.
+//
+// Before this, the service was completely open — including
+// POST /api/courted/account, which stores a Courted login, and POST /api/search,
+// which spends proxy credits. Anyone who knew the URL could drive it.
+//
+// PUBLIC_PATHS is deliberately tiny. /api/status stays open because the Command
+// Center's status board polls it unauthenticated to render the Agent Search
+// card; it exposes only an account count and the unblocker's name. Give that
+// connector a service token and this exemption can go.
+//
+// Fail-open when BS_SSO_SECRET is unset so `node web/server/index.js` still
+// runs locally. The boot log below states plainly which mode is active, so an
+// unset variable in production is visible rather than silent.
+app.use(async (req, res, next) => {
+    const secret = process.env.BS_SSO_SECRET;
+    if (!secret) return next(); // not configured — local development
+
+    if (PUBLIC_PATHS.some((p) => req.path === p || req.path.startsWith(`${p}/`))) {
+        return next();
+    }
+
+    const session = await verifySso(secret, readSsoCookie(req.headers.cookie));
+
+    if (!session) {
+        if (req.path.startsWith('/api/')) {
+            return res.status(401).json({ error: 'unauthorized' });
+        }
+        // Send them to the workspace to sign in. A login form here would be a
+        // second password to remember, which is the thing the workspace exists
+        // to remove.
+        return res.redirect(302, COMMAND_CENTER_URL);
+    }
+
+    if (!hasGrant(session, 'search')) {
+        if (req.path.startsWith('/api/')) {
+            return res.status(403).json({ error: 'forbidden' });
+        }
+        // Signed in but not entitled to this tool. Deliberately not a redirect
+        // to sign-in: they are already signed in, so that would just loop.
+        return res.status(403).type('html').send(noAccessPage(session.email));
+    }
+
+    req.bsUser = session;
+    next();
+});
