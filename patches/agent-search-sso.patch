+// bs-auth (verify only) — the BrokerStaffer single-sign-on token.
+//
+// A hand port of packages/bs-auth/index.ts for this app, which is plain ESM
+// JavaScript and cannot consume the TypeScript source the Next apps share.
+//
+// VERIFY ONLY, on purpose. This service never issues a credential; minting
+// lives solely in the Command Center. Leaving `mintSso` out means a compromise
+// here cannot forge a token for the other three apps.
+//
+// The port is guaranteed honest by a cross-implementation test
+// (scripts/verify-agent-search.mjs) that mints with the TypeScript library and
+// verifies with THIS file — so any drift in the algorithm fails a test rather
+// than silently rejecting everyone's sessions in production.
+
+export const SSO_COOKIE = 'bs_sso';
+
+/** Keep in step with ALL_TOOLS in packages/bs-auth/index.ts. */
+export const ALL_TOOLS = ['inbox', 'clients', 'analytics', 'search'];
+
+/** Matches CLOCK_SKEW_MS in the TypeScript source. */
+const CLOCK_SKEW_MS = 60 * 1000;
+
+const encoder = new TextEncoder();
+
+function base64UrlDecode(input) {
+    const padded = input.replace(/-/g, '+').replace(/_/g, '/');
+    const binary = atob(padded + '='.repeat((4 - (padded.length % 4)) % 4));
+    const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
+    return new TextDecoder().decode(bytes);
+}
+
+function toHex(buffer) {
+    return Array.from(new Uint8Array(buffer))
+        .map((b) => b.toString(16).padStart(2, '0'))
+        .join('');
+}
+
+// `a === b` short-circuits on the first differing byte, which leaks how much of
+// a forged signature was correct.
+export function safeEqual(a, b) {
+    if (a.length !== b.length) return false;
+    let diff = 0;
+    for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
+    return diff === 0;
+}
+
+async function hmacHex(secret, payload) {
+    const key = await crypto.subtle.importKey(
+        'raw',
+        encoder.encode(secret),
+        { name: 'HMAC', hash: 'SHA-256' },
+        false,
+        ['sign'],
+    );
+    return toHex(await crypto.subtle.sign('HMAC', key, encoder.encode(payload)));
+}
+
+// Signature first, payload second. Nothing inside the token is trusted until
+// the HMAC checks out.
+export async function verifySso(secret, token, now = Date.now()) {
+    if (!secret || !token) return null;
+
+    const dot = token.lastIndexOf('.');
+    if (dot <= 0 || dot === token.length - 1) return null;
+
+    const body = token.slice(0, dot);
+    const signature = token.slice(dot + 1);
+
+    if (!safeEqual(signature, await hmacHex(secret, body))) return null;
+
+    let parsed;
+    try {
+        parsed = JSON.parse(base64UrlDecode(body));
+    } catch {
+        return null;
+    }
+
+    if (!parsed || typeof parsed !== 'object') return null;
+
+    const email = typeof parsed.email === 'string' ? parsed.email.trim().toLowerCase() : '';
+    if (!email) return null;
+
+    const exp = typeof parsed.exp === 'number' && Number.isFinite(parsed.exp) ? parsed.exp : null;
+    if (exp === null) return null;
+    if (exp + CLOCK_SKEW_MS <= now) return null;
+
+    // Intersect with the known tools, so a tool name we do not recognise —
+    // from a newer issuer, or a typo — grants nothing rather than something.
+    const claimed = Array.isArray(parsed.grants) ? parsed.grants : [];
+    const grants = ALL_TOOLS.filter((t) => claimed.includes(t));
+
+    return {
+        email,
+        grants,
+        ver: typeof parsed.ver === 'number' ? parsed.ver : 0,
+        iat: typeof parsed.iat === 'number' ? parsed.iat : 0,
+        exp,
+    };
+}
+
+export function hasGrant(session, tool) {
+    return !!session && session.grants.includes(tool);
+}
+
+// Parsing the Cookie header directly rather than adding a cookie-parser
+// dependency — this is the only cookie the server reads.
+export function readSsoCookie(cookieHeader) {
+    if (!cookieHeader) return undefined;
+    for (const part of cookieHeader.split(';')) {
+        const eq = part.indexOf('=');
+        if (eq === -1) continue;
+        if (part.slice(0, eq).trim() === SSO_COOKIE) {
+            return decodeURIComponent(part.slice(eq + 1).trim());
+        }
+    }
+    return undefined;
+}
