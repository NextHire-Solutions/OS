# BrokerStaffer OS — placeholders only. This repository is PUBLIC.
# Real values live in Railway variables and nowhere else.

# ── Signing ──────────────────────────────────────────────────────────────────
# Signs the SSO token. Every other app must receive this SAME value as its
# BS_SSO_SECRET, or it will reject every session this app issues.
#   openssl rand -hex 32
AUTH_SECRET=

# ── Who may sign in ──────────────────────────────────────────────────────────
# email:sha256hex pairs, comma or newline separated.
#   npm run hash -- 'the-password'
AUTH_USERS=you@brokerstaffer.com:<sha256-of-password>

# ── Who may open what ────────────────────────────────────────────────────────
# One line per person: email:tool,tool
# Tools: inbox | clients | analytics | search
#
# LEAVE UNSET and everyone in AUTH_USERS gets every tool — the deliberate
# bootstrap fail-open, so deploying this cannot lock you out of your own
# workspace. Once set, it is authoritative: anyone missing gets NOTHING.
BS_GRANTS=

# ── Cookie scope ─────────────────────────────────────────────────────────────
# The parent domain, so every app on a subdomain sees the cookie as
# first-party. LEAVE UNSET locally: localhost has no shared apex and setting a
# domain there silently drops the cookie.
SSO_COOKIE_DOMAIN=.brokerstaffer.com

# ── The tools the status board reads ─────────────────────────────────────────
MASTER_INBOX_URL=
CLIENT_HEALTH_URL=
ANALYTICS_URL=
SCRAPER_URL=

# Optional. Each unlocks one card's live numbers; absent, that card degrades
# on its own and the page still works.
MASTER_INBOX_ADMIN_TOKEN=
CLIENT_HEALTH_READ_TOKEN=
ANALYTICS_AUTH_SECRET=
ANALYTICS_CRON_SECRET=
ANALYTICS_SERVICE_EMAIL=command-center@brokerstaffer.com
# Accepted as x-admin-token by /api/tools/client-health/clients/onboard (the OS's own
# inbound onboarding endpoint, replacing the live tool's).
CLIENT_HEALTH_ONBOARDING_TOKEN=

# ── Campaign Analytics — served AND synced by the OS ─────────────────────────
# The tool's own variables, namespaced ANALYTICS_* so four Supabase projects can
# share one process. Names on the right are what the tool called them.
ANALYTICS_SUPABASE_URL=                       # SUPABASE_URL
ANALYTICS_SUPABASE_SERVICE_ROLE_KEY=          # SUPABASE_SERVICE_ROLE_KEY
# EmailBison workspace id. Every table's team_id. ANALYTICS_TEAM_ID is accepted
# as an alias; both default to 2.
ANALYTICS_EMAILBISON_TEAM_ID=2                # EMAILBISON_TEAM_ID
ANALYTICS_EMAILBISON_BASE_URL=https://send.brokerstaffer.com
ANALYTICS_EMAILBISON_API_KEY=                 # EMAILBISON_API_KEY
ANALYTICS_INSTANTLY_BASE_URL=https://api.instantly.ai
ANALYTICS_INSTANTLY_API_KEY=                  # INSTANTLY_API_KEY
# The client roster, refreshed by sync-entities. Optional: without it the
# matcher runs against the clients already stored rather than unassigning
# everything.
ANALYTICS_PORTAL_BASE_URL=                    # PORTAL_BASE_URL
ANALYTICS_PORTAL_TOKEN=                       # PORTAL_TOKEN
# The outcomes feed: GET /api/outcomes?updated_since=&page=&per_page= (max 200),
# Bearer auth. Polled incrementally by sync-outcomes and sync-reply-labels.
ANALYTICS_OUTCOMES_BASE_URL=                  # OUTCOMES_BASE_URL
ANALYTICS_OUTCOMES_TOKEN=                     # OUTCOMES_TOKEN

# ---- Cron -------------------------------------------------------------------
# The sync engine (src/lib/tools/analytics/sync) runs IN THIS PROCESS. There is
# no cron service: ANALYTICS_ENABLE_SCHEDULER=1 turns on the in-process ticker,
# which fires whatever sync/schedule.ts says is due. Unset it to stop all
# scheduled syncing — only do that while something else is driving the jobs.
ANALYTICS_ENABLE_SCHEDULER=1                  # ENABLE_SCHEDULER
# How far back a tick looks for jobs that came due: a fresh process replays
# this many minutes so a deploy at 05:59 does not lose the 06:00 sweep. 1
# restores the tool's exact-minute ticker.
ANALYTICS_CRON_WINDOW_MINUTES=10              # CRON_WINDOW_MINUTES
# ANALYTICS_CRON_SECRET (above) is also the bearer a machine caller presents to
# POST /api/tools/analytics/sync/run?job=<name>[&detach=1]. Unset = no bearer
# path, sessions still work.

# ── Client Health (the tool's own database and sources; the OS runs its sync) ─
# Same project and service key as the live tool. Namespaced so five tools can
# share one environment without colliding.
CLIENT_HEALTH_SUPABASE_URL=
CLIENT_HEALTH_SUPABASE_SERVICE_ROLE_KEY=
# The sync worker's sources. BISON_* and COROFY_* are optional: with no
# CLIENT_HEALTH_BISON_API_KEY the Bison step is skipped, and with either
# COROFY variable missing the Corofy step is skipped — the tool's own rules.
CLIENT_HEALTH_INSTANTLY_API_KEY=
CLIENT_HEALTH_BISON_API_KEY=
CLIENT_HEALTH_BISON_BASE_URL=https://send.brokerstaffer.com
CLIENT_HEALTH_COROFY_BASE_URL=
CLIENT_HEALTH_COROFY_ADMIN_TOKEN=
# Accepted as x-sync-secret by POST /api/tools/client-health/sync and
# /sync/tick, for a machine caller such as a Railway cron. LEAVE UNSET and that
# path is closed (the Sync button still works through the session); it never
# fails open the way the tool's SYNC_SECRET did.
CLIENT_HEALTH_SYNC_SECRET=
# Set to 1 to run the tool's */15 sync cadence in-process, ticked by any open
# Client Health screen. Off by default so a preview with production
# credentials never starts writing on its own.
CLIENT_HEALTH_SYNC_ENABLED=

# ── Master Inbox: receiving mail ─────────────────────────────────────────────
# The webhook receivers the providers POST to. Neither provider signs its
# payloads, so each receiver checks a shared secret carried as ?token= on the
# URL it was registered with. UNSET = the receiver answers 503 to everything
# (fails closed); a wrong token is 401.
#   openssl rand -hex 32
MASTER_INBOX_INSTANTLY_WEBHOOK_SECRET=
MASTER_INBOX_EMAILBISON_WEBHOOK_SECRET=
# Bootstrap secret for POST /api/tools/master-inbox/webhooks/register, which
# (re)registers the EmailBison receiver in every EmailBison team. 503 when unset.
MASTER_INBOX_WEBHOOK_REGISTER_SECRET=
# Bearer token for /api/tools/master-inbox/cron/sync-external-intros, for an
# external scheduler. Same shape as ANALYTICS_CRON_SECRET. 503 when unset.
MASTER_INBOX_CRON_SECRET=
# "1" runs Master Inbox's cron in-process instead (sync/scheduler.ts). Leave
# unset to schedule externally with the bearer above.
MASTER_INBOX_CRON_ENABLED=

# ── Onboarding (the orchestrator's integrations, run by the OS) ───────────────
# Every variable the deployed Onboarding tool reads unprefixed lives here under
# ONBOARDING_. Read by src/lib/tools/onboarding/env.ts.
#
# Inbound webhooks — point each third party at the OS (all POST, no session):
#   Typeform    https://os.brokerstaffer.com/api/tools/onboarding/webhooks/typeform      (Typeform-Signature)
#   Calendly    https://os.brokerstaffer.com/api/tools/onboarding/webhooks/calendly?token=ONBOARDING_CALENDLY_WEBHOOK_TOKEN
#   Stripe      https://os.brokerstaffer.com/api/tools/onboarding/webhooks/stripe        (checkout.session.completed)
#   Bison       https://os.brokerstaffer.com/api/tools/onboarding/webhooks/bison?token=ONBOARDING_BISON_WEBHOOK_TOKEN
#   Masterinbox https://os.brokerstaffer.com/api/tools/onboarding/webhooks/masterinbox?token=ONBOARDING_MASTERINBOX_WEBHOOK_TOKEN
ONBOARDING_TYPEFORM_WEBHOOK_SECRET=
ONBOARDING_TYPEFORM_TOKEN=
ONBOARDING_CALENDLY_WEBHOOK_TOKEN=
ONBOARDING_CALENDLY_EVENT_TYPE_URI=
ONBOARDING_CALENDLY_TOKEN=
ONBOARDING_BISON_WEBHOOK_TOKEN=
ONBOARDING_MASTERINBOX_WEBHOOK_TOKEN=
# Optional: a query-string token for the Stripe receiver. Verification does not
# rely on it — the Checkout Session is re-fetched from Stripe with the key below.
ONBOARDING_STRIPE_WEBHOOK_TOKEN=
ONBOARDING_DB_APP_WEBHOOK_TOKEN=

# EmailBison (external): campaign build / launch / pause.
ONBOARDING_BISON_BASE_URL=
ONBOARDING_BISON_API_KEY=

# Client Portal = Master Inbox. Falls back to MASTER_INBOX_URL and
# MASTER_INBOX_SUPABASE_SERVICE_ROLE_KEY / MASTER_INBOX_ADMIN_TOKEN above.
ONBOARDING_CLIENT_PORTAL_BASE_URL=
ONBOARDING_CLIENT_PORTAL_ADMIN_TOKEN=

# Health Dashboard: served by the OS itself (CLIENT_HEALTH_* above). The tool's
# HEALTH_DASH_* are not read.

# Slack: bot token + the channel the team pings land in; the intake announcements
# go to SLACK_ONBOARDING_CHANNEL_ID. SLACK_MENTION defaults to <!here> ("" disables).
ONBOARDING_SLACK_BOT_TOKEN=
ONBOARDING_SLACK_CHANNEL_ID=
ONBOARDING_SLACK_ONBOARDING_CHANNEL_ID=
ONBOARDING_SLACK_MENTION=

# Gmail (READ side — replies and the connection check; sending is switched off).
# Register this redirect URI in Google Cloud:
#   https://os.brokerstaffer.com/api/tools/onboarding/auth/google/callback
ONBOARDING_GOOGLE_OAUTH_CLIENT_ID=
ONBOARDING_GOOGLE_OAUTH_CLIENT_SECRET=
ONBOARDING_GOOGLE_OAUTH_REDIRECT_URI=https://os.brokerstaffer.com/api/tools/onboarding/auth/google/callback
APP_BASE_URL=https://os.brokerstaffer.com

# Stripe: read only (mode badge + webhook verification). No link is ever created.
ONBOARDING_STRIPE_MODE=
ONBOARDING_STRIPE_SECRET_KEY=
ONBOARDING_STRIPE_SECRET_KEY_TEST=
ONBOARDING_TAC_EMAIL=

# Scheduled jobs. The bearer secret for /api/tools/onboarding/cron/* (poll-replies,
# health-status, check-bison-imports, followups, tick) — fails closed when unset.
#   openssl rand -hex 32
ONBOARDING_CRON_SECRET=
# Set to 1 on EXACTLY ONE process to run the 10-minute in-process ticker
# (src/lib/tools/onboarding/scheduler.ts). Leave unset on previews and laptops.
ONBOARDING_CRON_ENABLED=
# Follow-up clock: days after the onboarding call, and the Touch Base link.
ONBOARDING_FOLLOWUP_DAYS=21
ONBOARDING_FOLLOWUP_BOOKING_URL=
